# Agent A Configuration
AGENT_A_PRIVATE_KEY=0xYourAgentAPrivateKeyHere
AGENT_A_PUBLIC_ADDRESS=0xYourAgentAPublicAddressHere
AGENT_A_NAME=AgentA
AGENT_A_MAX_BID=
# Optional: Set fixed budget (e.g., AGENT_A_MAX_BID=10), or leave empty to let agent research and decide ($5-$100)

# Agent B Configuration
AGENT_B_PRIVATE_KEY=0xYourAgentBPrivateKeyHere
AGENT_B_PUBLIC_ADDRESS=0xYourAgentBPublicAddressHere
AGENT_B_NAME=AgentB
AGENT_B_MAX_BID=
# Optional: Set fixed budget (e.g., AGENT_B_MAX_BID=15), or leave empty to let agent research and decide ($5-$100)

# Shared Agent Config
BID_ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-api-key-here
BID_FIRECRAWL_API_KEY=fc-your-firecrawl-api-key-here  # Required for web search (get from https://firecrawl.dev)

# Server Configuration
BID_SERVER_URL=http://localhost:3000
RETRY_DELAY_MIN_MS=1000
RETRY_DELAY_MAX_MS=3000

# Basename to bid on
BASENAME_TO_AUCTION=your-basename.base.eth

# Firecrawl API endpoint (usually no need to change)
FIRECRAWL_API_BASE_URL=https://api.firecrawl.dev/v2/x402/search
